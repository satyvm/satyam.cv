    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new": "tsx scripts/new-post.ts",
    "update-link-metadata": "tsx scripts/update-link-metadata.ts",
    "update-theme": "tsx scripts/update-theme.ts",
    "compile-resume": "tsx scripts/compile-resume.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.42.0",
    "feed": "^6.0.0",
    "katex": "^0.18.1",
