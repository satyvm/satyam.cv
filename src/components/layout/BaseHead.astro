---
import { themeConfig } from '@/config'
import type { BaseHeadProps } from '@/types'
import StructuredData from '@/components/layout/StructuredData.astro'
import katexCssUrl from 'katex/dist/katex.min.css?url'

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  pageType = 'website',
  robots,
  publishedTime,
  modifiedTime,
  tags = []
} = Astro.props as BaseHeadProps

const pageTitle = title || themeConfig.site.title
const pageDescription = description || themeConfig.site.description
const imageUrl = ogImage ? new URL(ogImage, Astro.url).href : new URL(themeConfig.site.defaultOgImage, Astro.site).href
const imageAltText = ogImageAlt || pageTitle
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link
  rel="icon"
  href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌸</text></svg>"
/>
<link rel="preload" href="/fonts/Inter.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/fonts/Besley-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${themeConfig.site.title} RSS Feed`} href={new URL('rss.xml', Astro.site)} />
<link rel="alternate" type="application/atom+xml" title={`${themeConfig.site.title} Atom Feed`} href={new URL('atom.xml', Astro.site)} />
<link rel="alternate" type="application/feed+json" title={`${themeConfig.site.title} JSON Feed`} href={new URL('feed.json', Astro.site)} />
{themeConfig.post.katex && <link rel="stylesheet" href={katexCssUrl} media="print" onload={`this.media='all'`} />}
<meta name="generator" content={Astro.generator} />

<!-- Robots directive if specified -->
{robots && <meta name="robots" content={robots} />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={pageDescription} />
<meta name="author" content={themeConfig.site.author} />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={themeConfig.site.title} />
<meta property="og:locale" content={themeConfig.site.language} />
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAltText} />

<!-- Article-specific Open Graph tags -->
{pageType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{pageType === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{pageType === 'article' && (
  <meta property="article:author" content={themeConfig.site.author} />
)}
{pageType === 'article' && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@satyvm" />
<meta name="twitter:creator" content="@satyvm" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAltText} />

<!-- Structured Data -->
<StructuredData
  pageType={pageType}
  title={pageTitle}
  description={pageDescription}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={tags}
  ogImage={imageUrl}
  canonicalUrl={canonicalURL.href}
/>
