---
import PostList from '@/components/widgets/PostList.astro'
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'
import { videos } from '@/data/videos'
import { getCollection, render } from 'astro:content'

const posts = await getSortedFilteredPosts()

const notesCollection = await getCollection('notes')
const notes = notesCollection.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const renderedNotes = await Promise.all(
  notes.map(async (note) => {
    const { Content } = await render(note)
    return { ...note, Content }
  })
)
---

<main>
  <section class="section">
    <h2 class="section-label">Writing</h2>
    <PostList posts={posts} />
  </section>

  <section class="section">
    <h2 class="section-label">Videos</h2>
    <ul class="item-list">
      {
        videos.map((video) => (
          <li>
            <a href={video.url} target="_blank" rel="noopener noreferrer" class="hover-item">
              <div class="item-row">
                <p class="item-title">{video.title}</p>
                <div class={themeConfig.general.postListDottedDivider ? 'item-dotted-divider' : 'item-divider'} />
                <p class="date">
                  <FormattedDate date={video.date} context="list" />
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2 class="section-label">Notes</h2>
    <ul class="notes-list">
      {
        renderedNotes.map((note) => (
          <li class="note-item">
            <p class="date">
              <FormattedDate date={note.data.date} context="list" />
            </p>
            <div class="note-content">
              <note.Content />
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="placeholder"></div>
</main>

<style>
  .notes-list {
    padding: 0;
    margin: 0;
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .note-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .note-content {
    color: var(--text-primary);
    line-height: 1.6;
  }

  .note-content :global(p) {
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .note-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
