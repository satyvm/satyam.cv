---
import { workExperience, projects } from '@/data/about'
import NamePlayground from '@/components/ui/NamePlayground.astro'

const selectedProjects = projects.filter((project) => project.url).slice(0, 4)
---

<div class="portfolio-home">
  <div class="overview">
    <div class="introduction">
      <section class="statement" aria-labelledby="intro-title">
        <h1 id="intro-title">I build infrastructure people can rely on.</h1>
      </section>
      <section class="biography" aria-label="About Satyam">
        <p class="current-role">Software Engineer at Golden Hills Capital in Hyderabad. Contributing to open source.</p>
        <p>
          I studied at IIT Madras, worked at an early-stage hedge fund, and helped build a fintech startup as a founding
          engineer. My work spans backend systems, cloud infrastructure, crypto, and finance.
        </p>
        <p>
          I want to build technology that users, developers, and AI can rely on—and be part of something meaningful.
        </p>
        <p>Away from the keyboard: basketball, sketches, Valorant, and music.</p>
      </section>
    </div>
    <div class="work-summary">
      <section class="projects" aria-labelledby="projects-title">
        <h2 id="projects-title">Selected projects</h2>
        <ul>
          {
            selectedProjects.map((project) => (
              <li>
                <a href={project.url} target="_blank" rel="noopener noreferrer">
                  {project.title}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href="https://github.com/satyvm" target="_blank" rel="noopener noreferrer"
          >More on GitHub <span aria-hidden="true">↗</span></a
        >
      </section>
      <section class="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        <ol>
          {
            workExperience.slice(0, 3).map((entry) => (
              <li>
                <h3>{entry.organization?.split(' · ').pop()?.split(',')[0].replace(' India Pvt Ltd', '')}</h3>
                <p class="experience-role">{entry.title.replace(' — ', ', ')}</p>
                <p class="experience-period">{entry.period}</p>
              </li>
            ))
          }
        </ol>
        <a class="text-link" href="/about">More about me <span aria-hidden="true">↗</span></a>
      </section>
    </div>
  </div>
  <div class="home-footer">
    <nav class="social-links" aria-label="Connect with Satyam">
      <a href="mailto:hi@satyvm.com">Email</a>
      <a href="https://linkedin.com/in/satyvm" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://x.com/satyvm" target="_blank" rel="noopener noreferrer">X</a>
      <a href="https://github.com/satyvm" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
    <NamePlayground />
  </div>
</div>

<style>
  .overview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: clamp(2rem, 4vw, 4rem);
  }
  .introduction {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 2vw, 2rem);
    align-items: start;
  }
  .work-summary {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: clamp(1.5rem, 2vw, 2rem);
    align-items: start;
  }
  .projects {
    text-align: right;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--page-heading-size);
    line-height: 1.3;
    letter-spacing: -0.05em;
    margin: -0.15em 0 0;
    max-width: 16ch;
  }
  h2 {
    font-size: var(--page-section-size);
    font-weight: 500;
    letter-spacing: -0.025em;
    margin: 0 0 0.65rem;
  }
  .biography p {
    color: var(--text-secondary);
    font-size: var(--page-body-size);
    line-height: var(--page-line-height);
    margin: 0 0 1.25rem;
  }
  .biography .current-role {
    color: var(--text-primary);
  }
  .biography p:last-child {
    margin-bottom: 0;
  }
  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .experience li {
    font-size: var(--font-size-s);
    line-height: 1.6;
    margin-bottom: 0.9rem;
  }
  .experience h3 {
    font-size: inherit;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .experience-role,
  .experience-period {
    margin: 0;
    color: var(--text-secondary);
  }
  .experience-period {
    font-size: 0.75rem;
    margin-top: 0.2rem;
  }
  a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .text-link {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    font-size: var(--font-size-s);
  }
  .text-link span {
    color: var(--text-secondary);
  }
  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .projects li {
    font-size: var(--font-size-s);
    line-height: 1.6;
  }
  .projects li a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--text-tertiary);
  }
  .projects li a:hover {
    text-decoration-color: currentColor;
  }
  .projects .text-link {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--text-tertiary);
  }
  .experience .text-link {
    margin-top: 0.2rem;
  }
  .home-footer {
    margin-top: clamp(3rem, 6vh, 5rem);
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .social-links a {
    background: var(--code-bg);
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
    font-size: var(--font-size-s);
  }
  .social-links a:hover {
    background: var(--selection);
  }
  .home-footer :global(name-playground) {
    margin-top: 1rem;
    padding-top: 1rem;
  }
  @media (max-width: 1100px) {
    .overview {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .introduction {
      grid-template-columns: 1fr 1.3fr;
      gap: 3rem;
    }
    .work-summary {
      grid-template-columns: 1fr 1.3fr;
      gap: 3rem;
    }
    h1 {
      font-size: 2.75rem;
    }
  }
  @media (max-width: 600px) {
    .overview,
    .introduction {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .work-summary {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
      gap: 1.25rem;
    }
    .work-summary h2 {
      font-size: 0.9375rem;
      margin-bottom: 0.65rem;
    }
    h1 {
      font-size: 2.5rem;
      max-width: 16ch;
    }
    h2 {
      margin-bottom: 1.25rem;
    }
    .biography p {
      font-size: var(--font-size-m);
    }
    .home-footer {
      margin-top: 3.5rem;
    }
    .home-footer :global(name-playground) {
      padding-top: 2rem;
    }
  }
</style>
