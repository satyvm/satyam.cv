---
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import type { PostListProps } from '@/types'
import { themeConfig } from '@/config'

const { posts } = Astro.props as PostListProps
---

<ul class="item-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/${post.id}/`} class="hover-item">
          <div class={`item-row ${!themeConfig.date.dateOnRight ? 'date-left' : ''}`}>
            {!themeConfig.date.dateOnRight && (
              <p class="date">
                <FormattedDate date={post.data.pubDate} context="list" />
              </p>
            )}
            <p class="item-title">{post.data.title}</p>
            {themeConfig.date.dateOnRight && (
              <div class={themeConfig.general.postListDottedDivider ? 'item-dotted-divider' : 'item-divider'} />
            )}
            {themeConfig.date.dateOnRight && (
              <p class="date">
                <FormattedDate date={post.data.pubDate} context="list" />
              </p>
            )}
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .item-row.date-left {
    justify-content: flex-start;
  }

  .item-row.date-left .item-title {
    flex: 1 1 auto;
    min-width: 0;
  }

  .item-row.date-left .date {
    margin-right: 0.75rem;
  }
</style>
