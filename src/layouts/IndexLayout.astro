---
import '@/styles/global.css'
import BaseHead from '@/components/layout/BaseHead.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { themeConfig } from '@/config'

const { title, description, robots } = Astro.props
const pageTitles: Record<string, string> = {
  '/about': 'About me.',
  '/content': 'Writing & notes.',
  '/library': 'The library.',
  '/work': 'Selected work.'
}
const pageTitle = pageTitles[Astro.url.pathname.replace(/\/$/, '')]
---

<BaseLayout title={title} description={description} type="page">
  <BaseHead title={title} description={description} robots={robots} slot="head" />
  <div class="page-content">
    <div>
      <Header />
    </div>
    <main class="index-main">
      {pageTitle && <h1 class="page-title">{pageTitle}</h1>}
      <slot />
    </main>
    {
      themeConfig.general.footer && (
        <div>
          <Footer />
        </div>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  .page-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .page-content > .index-main {
    flex: 1;
    width: 100%;
    max-width: calc(var(--content-width) - 3rem);
    margin-inline: auto;
  }

  .page-content > .index-main:has(.portfolio-home) {
    max-width: none;
  }

  .page-content > .index-main:has(.resume-document) {
    max-width: 52rem;
  }

  .index-main {
    font-size: var(--page-body-size);
    line-height: var(--page-line-height);
  }

  .index-main .section-label {
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .index-main .item-row {
    height: auto;
    min-height: 2.75rem;
    padding-block: 0.25rem;
  }

  .index-main .item-title {
    white-space: normal;
    overflow: visible;
  }

  .index-main .date {
    font-size: var(--page-body-size);
    letter-spacing: -0.02em;
    opacity: 1;
  }

  .page-title {
    font-family: var(--serif);
    font-size: var(--page-heading-size);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.05em;
    margin: -0.15em 0 2rem;
  }
</style>
